{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "projects": {
        "shared": {
            "root": "libs/shared",
            "sourceRoot": "libs/shared/src",
            "projectType": "library"
        },
        "frontend": "apps/frontend",
        "backend": "apps/backend"
    },
    "tasksRunnerOptions": {
        "default": {
            "runner": "nx/tasks-runners/default",
            "options": {
                "cacheableOperations": [
                    "build",
                    "lint",
                    "test",
                    "e2e",
                    "build-ssr",
                    "serve-ssr",
                    "migrate-db"
                ]
            }
        }
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"],
            "cache": true,
            "outputs": ["{projectRoot}/dist"]
        },
        "build-ssr": {
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"],
            "cache": true,
            "outputs": ["{projectRoot}/server"]
        },
        "test": {
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/jest.preset.js"
            ],
            "cache": true
        },
        "lint": {
            "inputs": [
                "default",
                "{workspaceRoot}/.eslintrc.json",
                "{workspaceRoot}/.prettierrc.json"
            ],
            "cache": true
        },
        "serve": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "serve-ssr": {
            "dependsOn": ["build-ssr"],
            "cache": false
        },
        "migrate-db": {
            "cache": false,
            "inputs": [
                "{projectRoot}/src/migrations/**/*",
                "{projectRoot}/database/**/*"
            ]
        }
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/**/*.spec.[jt]s",
            "!{projectRoot}/**/*.md",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/jest.config.[jt]s",
            "!{projectRoot}/.eslintrc.json",
            "!{projectRoot}/src/test-setup.[jt]s",
            "!{projectRoot}/database/backups/**/*"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/.env*"
        ]
    },
    "generators": {
        "@nx/angular:application": {
            "style": "scss",
            "linter": "eslint",
            "unitTestRunner": "jest",
            "e2eTestRunner": "cypress",
            "ssr": true,
            "pwa": true,
            "standalone": false
        },
        "@nx/nest:application": {
            "linter": "eslint",
            "unitTestRunner": "jest",
            "standalone": false
        }
    },
    "workspaceLayout": {
        "appsDir": "apps",
        "libsDir": "libs"
    }
}
