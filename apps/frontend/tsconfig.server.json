{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "outDir": "./out-tsc/server",
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "types": ["node"],
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true
    },
    "files": ["src/main.server.ts", "src/server.ts"],
    "include": ["src/**/*.d.ts"]
}
