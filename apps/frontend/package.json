{
    "name": "@cv_2.0/frontend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "ng": "ng",
        "dev": "node dist/cv_2.0/server/server.mjs",
        "dev:prod": "ng run cv_2.0:serve-ssr:production",
        "start": "ng run cv_2.0:serve-ssr:development",
        "dev:no-ssr": "ng serve --configuration=development",
        "start:prod": "node dist/cv_2.0/server/server.mjs",
        "build": "ng build --configuration=production",
        "build:dev": "ng build --configuration=development",
        "build:prod": "ng build --configuration=production",
        "watch": "ng build --watch --configuration=development",
        "test": "ng test",
        "coverage": "ng test --no-watch --code-coverage",
        "lint": "ng lint",
        "format": "prettier --write \"**/*.{ts,js,json,html,css,scss}\" --config ../../.prettierrc.frontend.json",
        "storybook": "ng run cv_2.0:storybook",
        "build-storybook": "ng run cv_2.0:build-storybook",
        "serve": "node dist/cv_2.0/server/server.mjs",
        "serve:ssr": "ng run cv_2.0:serve-ssr",
        "serve:ssr:dev": "ng run cv_2.0:serve-ssr --configuration=development",
        "serve:ssr:prod": "ng run cv_2.0:serve-ssr --configuration=production",
        "heroku-postbuild": "npm run build:ssr",
        "build:ssr": "ng build --configuration=production && ng run cv_2.0:server:production",
        "build:server": "ng run cv_2.0:server",
        "compile:server": "tsc -p tsconfig.server.json",
        "prettier": "npx prettier \"./{css,html,js,src}/**\" --write --config ../../.prettierrc.frontend.json",
        "start:all": "concurrently \"npm run dev\" \"cd ../backend && npm run start:dev\""
    },
    "dependencies": {
        "@angular/animations": "^21.0.6",
        "@angular/cdk": "~21.0.5",
        "@angular/common": "^21.0.6",
        "@angular/compiler": "^21.0.6",
        "@angular/core": "^21.0.6",
        "@angular/fire": "^20.0.1",
        "@angular/forms": "^21.0.6",
        "@angular/material": "~21.0.5",
        "@angular/platform-browser": "^21.0.6",
        "@angular/platform-browser-dynamic": "^21.0.6",
        "@angular/platform-server": "^21.0.6",
        "@angular/pwa": "^21.0.4",
        "@angular/router": "^21.0.6",
        "@angular/service-worker": "^21.0.6",
        "@angular/ssr": "^21.0.4",
        "@gilsdav/ngx-translate-router": "^8.0.0",
        "@gilsdav/ngx-translate-router-http-loader": "^2.0.0",
        "@nebular/eva-icons": "^16.0.0",
        "@ngrx/component-store": "21.0.1",
        "@ngrx/effects": "21.0.1",
        "@ngrx/entity": "21.0.1",
        "@ngrx/operators": "21.0.1",
        "@ngrx/router-store": "21.0.1",
        "@ngrx/signals": "^21.0.1",
        "@ngrx/store": "21.0.1",
        "@ngrx/store-devtools": "21.0.1",
        "@ngx-translate/core": "^17.0.0",
        "@ngx-translate/http-loader": "^17.0.0",
        "@types/http-proxy-middleware": "^1.0.0",
        "eva-icons": "^1.1.3",
        "http-proxy": "^1.18.1",
        "http-proxy-middleware": "3.0.5",
        "npx": "^10.2.2",
        "primeicons": "^7.0.0",
        "primeng": "^21.0.2",
        "zone.js": "^0.16.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21.0.4",
        "@angular-eslint/builder": "21.1.0",
        "@angular-eslint/eslint-plugin": "21.1.0",
        "@angular-eslint/eslint-plugin-template": "21.1.0",
        "@angular-eslint/schematics": "21.1.0",
        "@angular-eslint/template-parser": "21.1.0",
        "@angular/build": "^21.0.4",
        "@angular/cli": "^21.0.4",
        "@angular/compiler-cli": "^21.0.6",
        "@angular/localize": "^21.0.6",
        "@compodoc/compodoc": "^1.1.32",
        "@storybook/angular": "^10.1.11",
        "@types/jasmine": "~5.1.13",
        "@types/mocha": "^10.0.10",
        "browser-sync": "^3.0.4",
        "jasmine-core": "~5.13.0",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "ngx-build-plus": "^20.0.0"
    }
}
