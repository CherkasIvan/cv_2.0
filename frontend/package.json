{
  "name": "cv_2.0",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node dist/cv_2.0/server/server.mjs",
    "dev:prod": "ng run cv_2.0:serve-ssr:production",
    "start": "ng run cv_2.0:serve-ssr:development",
    "dev:no-ssr": "ng serve --configuration=development",
    "start:prod": "node dist/cv_2.0/server/server.mjs",
    "build": "ng build --configuration=production",
    "build:dev": "ng build --configuration=development",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "coverage": "ng test --no-watch --code-coverage",
    "lint": "ng lint",
    "storybook": "ng run cv_2.0:storybook",
    "build-storybook": "ng run cv_2.0:build-storybook",
    "serve": "node dist/cv_2.0/server/server.mjs",
    "serve:ssr": "ng run cv_2.0:serve-ssr",
    "serve:ssr:dev": "ng run cv_2.0:serve-ssr --configuration=development",
    "serve:ssr:prod": "ng run cv_2.0:serve-ssr --configuration=production",
    "heroku-postbuild": "npm run build:ssr",
    "build:ssr": "ng build --configuration=production && ng run cv_2.0:server:production",
    "build:server": "ng run cv_2.0:server",
    "compile:server": "tsc -p tsconfig.server.json",
    "prettier": "npx prettier \"./{css,html,js,src}/**\" --write --log-level=\"warn\"",
    "start:all": "concurrently \"npm run dev\" \"cd ../backend && npm run start:dev\""
  },
  "private": true,
  "dependencies": {
