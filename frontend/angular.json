{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cv_2.0": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "cv",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "allowedCommonJsDependencies": [
              "undici",
              "faye-websocket",
              "@grpc/grpc-js",
              "@grpc/proto-loader",
              "http-proxy-middleware"
            ],
            "outputPath": "dist/cv_2.0",
            "index": {
              "input": "src/index.html",
              "output": "index.html"
            },
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "server.ts"
            },
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.scss",
              "src/assets/styles/_variables.scss",
              "src/assets/styles/_reset.scss",
              "src/assets/styles/_global.scss",
              "src/assets/styles/_material.scss",
              "src/assets/styles/mixins/_flex.mixin.scss",
              "src/assets/styles/mixins/_glassmorphism.mixin.scss",
              "src/assets/styles/mixins/_layout.mixin.scss",
              "src/assets/styles/mixins/_neon.mixin.scss",
              "src/assets/styles/mixins/_animations-mixins.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": true
              },
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "index": {
                "input": "src/index.html",
                "output": "index.csr.html"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "cv_2.0:build:production",
              "proxyConfig": "proxy.conf.json"
            },
            "development": {
              "buildTarget": "cv_2.0:build:development",
              "proxyConfig": "proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve-ssr": {
          "builder": "@angular-devkit/build-angular:ssr-dev-server",
          "options": {
            "port": 4000,
            "proxyConfig": "proxy.conf.json",
            "browserTarget": "cv_2.0:build:development",
            "serverTarget": "cv_2.0:build:development"
          },
          "configurations": {
            "development": {
              "browserTarget": "cv_2.0:build:development",
              "serverTarget": "cv_2.0:build:development"
            },
            "production": {
              "browserTarget": "cv_2.0:build:production",
              "serverTarget": "cv_2.0:build:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "prerender": {
          "builder": "@angular-devkit/build-angular:prerender",
          "options": {
            "routes": [
              "/",
              "/auth",
              "/layout",
              "/about",
              "/projects",
              "/experience",
              "/technologies",
              "/contact"
            ],
            "browserTarget": "cv_2.0:build:production"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "cv_2.0:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.scss",
              "src/assets/styles/_variables.scss",
              "src/assets/styles/_reset.scss",
              "src/assets/styles/_global.scss",
              "src/assets/styles/_material.scss",
              "src/assets/styles/mixins/_flex.mixin.scss",
              "src/assets/styles/mixins/_glassmorphism.mixin.scss",
              "src/assets/styles/mixins/_layout.mixin.scss",
              "src/assets/styles/mixins/_neon.mixin.scss",
              "src/assets/styles/mixins/_animations-mixins.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  }
}